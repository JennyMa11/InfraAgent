# Publish project code, build configuration, and the top-level README only.
# Documentation, corpora, experiments, archives, and logs stay local.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/scripts/
!/tests/
!/desktop/
!/web/

# Track Python source under the approved roots.
/src/**
!/src/**/
!/src/**/*.py
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

# Track the native application and its build scripts.
/desktop/**
!/desktop/**/
!/desktop/**/*.swift
!/desktop/**/*.sh

# Keep generated caches and OS metadata out even when a parent is re-included.
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store
