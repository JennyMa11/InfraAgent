# Publish project code and build configuration only.
# Documentation, corpora, experiments, archives, and logs stay local.
/*
!/.gitignore
!/pyproject.toml
!/uv.lock
!/src/
!/scripts/
!/tests/
!/desktop/

# Track Python source under the approved roots.
/src/**
!/src/**/
!/src/**/*.py
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

# Track the native application and its build scripts.
/desktop/**
!/desktop/**/
!/desktop/**/*.swift
!/desktop/**/*.sh
