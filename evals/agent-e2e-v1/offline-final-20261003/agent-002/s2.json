      {
        "id": "Eac18785214997df967d59d37",
        "chunk_id": "75cddac605540cc16e9af550",
        "parent_id": "a6acb07dfcd80d64e5131fbf",
        "source": "/Users/jennyma/Projects/InfraAgent/evals/agent-e2e-v1/corpus/vllm-automatic_prefix_caching.md",
        "sha256": "a939df40f6cde38cc48701cfee6626dbdc73c4f1e5df46921a7b88c496e31580",
        "locator": "/Users/jennyma/Projects/InfraAgent/evals/agent-e2e-v1/corpus/vllm-automatic_prefix_caching.md#L25-L25",
        "content": "APC in general does not reduce the performance of vLLM.\nWith that being said, APC only reduces the time of processing the queries (the prefilling phase) and does not reduce the time of generating new tokens (the decoding phase).",
        "truncated": false,
        "metadata": {
          "release": "v0.10.2",
          "commit": "01efc7ef781391e744ed08c3292817a773d654e6",
          "source_type": "documentation"
        }
