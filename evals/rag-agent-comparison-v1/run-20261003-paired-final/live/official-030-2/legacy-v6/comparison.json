        ]
      }
    },
    {
      "citation_id": "E975deafa225ca4d6fc6b62f9",
      "chunk_id": "fe2d6e472702fefa2a0e898c",
      "parent_id": "a79bf156e52f6563313513ce",
      "source": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-maximize-utilization.md",
      "locator": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-maximize-utilization.md#L7-L7",
      "page": null,
