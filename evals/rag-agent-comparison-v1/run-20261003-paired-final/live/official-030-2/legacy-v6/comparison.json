      "modality": "text",
      "bbox": null,
      "coordinate_space": null,
      "image_path": null,
      "caption_source": null,
      "caption_locator": null,
      "content": "At a high level, the application should maximize parallel execution between the host, the devices, and the bus connecting the host to the devices, by using asynchronous functions calls and streams as described in Asynchronous Concurrent Execution. It should assign to each processor the type of work it does best: serial workloads to the host; parallel workloads to the devices.",
      "truncated": false,
      "metadata": {
        "collection": "official",
        "document_id": "cuda-maximize-utilization",
        "url": "https://docs.nvidia.com/cuda/archive/13.0.1/cuda-c-programming-guide/index.html#maximize-utilization",
        "commit": null,
        "release": "13.0.1",
        "sha256": "a9a415a77b13676be9949caf74e7989415ce1e7379adcbfe9eed0ef7a4555044",
        "product": "cuda",
        "metadata_method": "frozen_manifest",
