  "query": "CUDA 13.0.1：异构代码中的串行控制循环与数据并行运算，按指南应分别放在host还是device？",
  "answerable": true,
  "delivered": {
    "coverage": 1.0,
    "complete": 1.0
  },
  "evidence": [
    {
      "citation_id": "E337b66565141142df21873de",
      "chunk_id": "45a513233cb59baabff75274",
      "parent_id": "3d31297aa33ec7597b441fe4",
      "source": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-cuda-graphs.md",
      "locator": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-cuda-graphs.md#L434-L434",
      "page": null,
      "start_line": 434,
