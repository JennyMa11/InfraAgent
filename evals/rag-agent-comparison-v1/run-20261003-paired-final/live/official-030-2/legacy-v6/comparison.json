    {
      "citation_id": "E7fbb97b1535281a3457fa8b6",
      "chunk_id": "7e2ef60cf1af5ba4128c5135",
      "parent_id": "7e6bc9064251c975ad100ced",
      "source": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-device-memory.md",
      "locator": "/Users/jennyma/Projects/InfraAgent/data/official-evals/infra-official-v1/corpus/cuda-device-memory.md#L3-L3",
      "page": null,
      "start_line": 3,
