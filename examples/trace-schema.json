{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Trace v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "config_id",
    "repetition",
    "provenance",
    "status",
    "latency_ms",
    "steps",
    "final",
    "claims",
    "evidence",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "arguments",
          "status",
          "observation",
          "duration_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "tool",
              "model",
              "decision"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "blocked"
            ]
          },
          "observation": {
            "type": "string"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "recovery_of": {
            "type": "string",
            "minLength": 1
          },
          "retry_of": {
            "type": "string",
            "minLength": 1
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "cache": {
            "type": "object",
            "required": [
              "eligible",
              "hit"
            ],
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "hit": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "required": [
                "operation_id"
              ]
            }
          }
        ]
      }
    },
    "final": {
      "type": "object",
      "required": [
        "status",
        "answer",
        "citations"
      ],
      "properties": {
        "status": {
          "enum": [
            "answered",
            "refused",
            "escalated",
            "error"
          ]
        },
        "answer": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "evidence_id"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "candidate_ids",
        "ranked_ids",
        "delivered"
      ],
      "properties": {
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ranked_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "sha256",
              "content",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "model_cost_usd",
        "tool_cost_usd"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tool_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "description": "Timestamps/provider metadata may be added. Sequential recovery links, evidence/citation consistency and failure-state consistency are additionally checked by the scorer; missing semantic reviews never imply correctness."
}
