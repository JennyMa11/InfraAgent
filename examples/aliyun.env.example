# 复制为项目根目录 .env.aliyun；Git忽略，默认优先读取
# 业务空间专属域名：将YOUR_WORKSPACE_ID替换为你的Workspace ID
INFRA_RAG_LLM_PROVIDER=openai
# INFRA_RAG_LLM_PROVIDER=ollama
OPENAI_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-flash-2026-07-15
OPENAI_MAX_TOKENS=1024
DASHSCOPE_API_KEY=YOUR_ALIYUN_API_KEY
# 切回其他配置：设置 INFRA_RAG_LLM_ENV_FILE=.env.deepseek 或 .env.aihubmix
