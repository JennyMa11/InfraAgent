# 复制为项目根目录 .env.aihubmix；该文件被Git忽略
# 默认优先读取 .env.aihubmix；修改配置后重启服务
INFRA_RAG_LLM_PROVIDER=openai
# 切回本地：将上面的 openai 改成 ollama
# INFRA_RAG_LLM_PROVIDER=ollama
# 切回DeepSeek：启动前设置 INFRA_RAG_LLM_ENV_FILE=.env.deepseek
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=coding-glm-4.6-free
AIHUBMIX_MAX_TOKENS=1024
AIHUBMIX_API_KEY=YOUR_API_KEY
