# Copy to ignored project file .env.agentrouter; never put a real key in this template.
# Keep the original local qwen3:4b:
INFRA_RAG_LLM_PROVIDER=ollama
# To switch only the answer generator to AgentRouter, replace the line above with:
# INFRA_RAG_LLM_PROVIDER=anthropic

ANTHROPIC_BASE_URL=https://agentrouter.org
# Use the model route assigned to your account; do not silently fall back to another model.
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_AUTH_TOKEN=YOUR_API_KEY

# ANTHROPIC_API_KEY is also accepted if ANTHROPIC_AUTH_TOKEN is not set.
# Environment variables override this file. INFRA_RAG_LLM_ENV_FILE selects a different file.
