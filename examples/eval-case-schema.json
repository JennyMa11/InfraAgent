{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Eval Case v1",
  "type": "object",
  "required": [
    "id",
    "task",
    "category",
    "provenance",
    "expected_status",
    "goals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "normal",
        "boundary",
        "tool_failure",
        "safety"
      ]
    },
    "expected_status": {
      "enum": [
        "answered",
        "refused",
        "escalated"
      ]
    },
    "semantic_review_required": {
      "type": "boolean",
      "default": true
    },
    "answerable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "format_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "tool_contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "recovery_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "unsafe_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "secret_canaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ranking_k": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_requirements": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_alternatives": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "source",
            "sha256",
            "text",
            "locator"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "task_success": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "type": "number",
          "minimum": 0
        },
        "format": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "rule",
            "human"
          ]
        },
        "predicate": {
          "$ref": "#/$defs/predicate"
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "predicate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "human"
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ]
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "required": [
        "path",
        "op"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "op": {
          "enum": [
            "exists",
            "equals",
            "contains",
            "lte",
            "gte"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "not": {
                  "const": "exists"
                }
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  },
  "description": "Cross-field uniqueness, weights, provenance checks and recovery links are additionally validated by agent_evaluation.py. Human judgments are external, hash-bound reviews."
}
