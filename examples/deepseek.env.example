# 官方 DeepSeek；复制为项目根目录 .env.deepseek（已被 Git 忽略）
# 切换为本地 Ollama：将下一行改成 ollama，然后重启服务
INFRA_RAG_LLM_PROVIDER=anthropic
# INFRA_RAG_LLM_PROVIDER=ollama
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_API_KEY=YOUR_API_KEY

# 可复制为项目根目录 .env.llm；当前配置文件优先于其他服务配置
# 英文技术文档的聊天检索优化；none 关闭，原始 search/evaluate 不翻译
INFRA_RAG_QUERY_LANGUAGE=english

# 切回 Ollama 时同时设置 INFRA_RAG_QUERY_LANGUAGE=none
